{
  "name": "netinjector",
  "version": "1.0.0",
  "description": "Production-ready desktop network scanner",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac dir",
    "dist": "electron-builder --mac dmg"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.netinjector.app",
    "productName": "NetInjector",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": null
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "package.json"
    ],
    "extraMetadata": {
      "main": "main.js"
    }
  },
  "author": "",
  "license": "MIT",
  "allowScripts": {
    "electron@31.7.7": true
  }
}
